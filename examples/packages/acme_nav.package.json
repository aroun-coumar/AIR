{
  "$schema": "ar.package/1.0",
  "name": "air/service/acme_nav",
  "version": "2.1.0",
  "kind": "service",
  "description": "Lidar-based localization and path planning for mobile and legged robots.",
  "license": "Apache-2.0",
  "maintainers": ["ACME Robotics (example)"],
  "provides": [
    { "interface": "air/service/navigation/plan_path", "version": "1.1.0" },
    { "interface": "air/service/localization/pose", "version": "1.0.0" }
  ],
  "requires": [
    { "interface": "air/primitive/chassis/odometry", "range": "^1.0" },
    { "interface": "air/service/mapping/get_map", "range": "^1.0", "optional": true,
      "description": "a prior map speeds up localization; without one it builds its own" }
  ],
  "hardware": {
    "robot_classes": ["robot.mobile.*", "robot.legged.*"],
    "devices": [
      { "types": ["sensor.lidar.*"], "min": 1, "description": "localization scans" }
    ],
    "frames": ["map", "odom", "base_link"],
    "incompatible_classes": ["robot.aerial.*"],
    "notes": "2D planner; aerial robots need a 3D planner"
  },
  "host": { "python": ">=3.11" },
  "config": [
    { "name": "max_speed", "type": "number", "required": false, "unit": "m/s", "minimum": 0, "maximum": 2.0 },
    { "name": "inflation_radius", "type": "number", "required": true, "unit": "m", "minimum": 0 }
  ],
  "entrypoint": "acme_nav.service:main",
  "tags": ["example", "navigation"]
}
