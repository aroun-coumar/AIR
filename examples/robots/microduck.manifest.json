{
  "$schema": "ar.component_manifest/1.1",
  "meta": {
    "source": "examples",
    "revision": 1
  },
  "robot_id": "duck-1",
  "name": "Microduck (example)",
  "hardware_revision": "example-A",
  "robot_class": "robot.legged.biped",
  "description": "Pollen Robotics Microduck served by robotd over JSON-RPC/NDJSON. Joint names follow duck-ipc-proto JOINT_NAMES; property values are example figures, not datasheet values. robotd clamps the actuator range only: there are no per-joint or thermal software limits.",
  "adapter": {
    "kind": "microduck",
    "profile": "robotd-api-44",
    "config": {
      "endpoint": "unix:///run/robotd.sock",
      "refresh_s": 0.1,
      "max_speed_mps": 0.2,
      "state_hz": 20
    }
  },
  "nominal_capabilities": [
    "locomotion",
    "head",
    "control_loop"
  ],
  "frames": [
    "odom",
    "trunk"
  ],
  "components": [
    {
      "component_id": "compute",
      "kind": "RK3566 compute module",
      "revision": "r1",
      "type_id": "compute.som.rockchip_npu_class",
      "properties": {
        "cpu_cores": 4,
        "ram": {
          "value": 2,
          "unit": "GB"
        },
        "compute": {
          "value": 0.8,
          "unit": "TOPS"
        },
        "tdp": {
          "value": 5,
          "unit": "W"
        }
      },
      "relations": [
        {
          "kind": "powered_by",
          "target": "battery"
        }
      ],
      "interfaces": [
        {
          "name": "uart-servo",
          "kind": "bus.uart"
        }
      ]
    },
    {
      "component_id": "imu",
      "kind": "Trunk IMU",
      "revision": "r1",
      "type_id": "sensor.imu.mems_6axis",
      "parent": "compute",
      "properties": {
        "accel_range": {
          "value": 16,
          "unit": "g0"
        },
        "gyro_range": {
          "value": 2000,
          "unit": "deg/s"
        },
        "output_data_rate": {
          "value": 200,
          "unit": "Hz"
        }
      },
      "interfaces": [
        {
          "name": "i2c",
          "kind": "bus.i2c"
        }
      ]
    },
    {
      "component_id": "tof",
      "kind": "Head multizone ToF",
      "revision": "r1",
      "type_id": "sensor.tof.multizone",
      "parent": "compute",
      "properties": {
        "zones": 64,
        "max_range": {
          "value": 4,
          "unit": "m"
        },
        "field_of_view": {
          "value": 63,
          "unit": "deg"
        },
        "update_rate": {
          "value": 15,
          "unit": "Hz"
        }
      },
      "interfaces": [
        {
          "name": "i2c",
          "kind": "bus.i2c"
        }
      ]
    },
    {
      "component_id": "camera",
      "kind": "Head camera",
      "revision": "r1",
      "type_id": "sensor.camera.rgb_rolling_shutter",
      "parent": "compute",
      "properties": {
        "resolution_px_h": 1920,
        "resolution_px_v": 1080,
        "frame_rate": {
          "value": 30,
          "unit": "fps"
        },
        "shutter": "rolling"
      },
      "interfaces": [
        {
          "name": "csi",
          "kind": "bus.mipi_csi2"
        }
      ]
    },
    {
      "component_id": "battery",
      "kind": "2S battery pack",
      "revision": "r1",
      "type_id": "power.battery.li_ion_nmc_pack",
      "properties": {
        "nominal_voltage": {
          "value": 7.4,
          "unit": "V"
        },
        "capacity": {
          "value": 2,
          "unit": "Ah"
        },
        "max_discharge_current": {
          "value": 10,
          "unit": "A"
        }
      }
    },
    {
      "component_id": "servo-left-hip-yaw",
      "kind": "Smart serial servo",
      "revision": "r1",
      "type_id": "actuator.module.smart_serial_servo",
      "properties": {
        "rated_voltage": {
          "value": 5,
          "unit": "V"
        },
        "stall_torque": {
          "value": 0.5,
          "unit": "N*m"
        },
        "bus": "ttl_half_duplex"
      },
      "relations": [
        {
          "kind": "powered_by",
          "target": "battery"
        },
        {
          "kind": "communicates_via",
          "target": "compute"
        }
      ],
      "interfaces": [
        {
          "name": "dxl",
          "kind": "app.dynamixel_protocol2"
        }
      ]
    },
