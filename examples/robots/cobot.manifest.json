      "component_id": "controller",
      "kind": "Robot controller",
      "revision": "r1",
      "type_id": "compute.robot_controller",
      "properties": {
        "axes_max": 7,
        "supply_voltage": {
          "value": 48,
          "unit": "V"
        }
      },
      "interfaces": [
        {
          "name": "ethercat",
          "kind": "fieldbus.ethercat"
        },
        {
          "name": "opcua",
          "kind": "app.opcua"
        }
      ]
    },
    {
