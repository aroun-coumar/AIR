  "meta": {
    "source": "examples",
    "revision": 1
  },
  "robot_id": "cobot-1",
  "name": "Six-axis collaborative arm (example)",
  "hardware_revision": "example-A",
  "robot_class": "robot.industrial.cobot",
  "description": "EtherCAT strain-wave joints with joint torque sensing and a wrist F/T sensor.",
  "adapter": {
    "kind": "unbound",
    "profile": "description-only",
    "config": {}
  },
  "nominal_capabilities": [
    "manipulation",
    "force_control",
    "grasping"
