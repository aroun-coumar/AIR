{
  "$schema": "ar.component_manifest/1.1",
  "meta": {
    "source": "examples",
    "revision": 1
  },
  "robot_id": "go2-1",
  "name": "Unitree quadruped (example)",
  "hardware_revision": "example-A",
  "robot_class": "robot.legged.quadruped",
  "description": "A Unitree quadruped reached through unitree_sdk2_python's DDS channel model: the 'sport' RPC service for high-level skills, rt/lowstate and rt/lowcmd behind admission. Property values are examples.",
  "adapter": {
    "kind": "unitree_sport",
    "profile": "sport-api-1.0.0.1",
    "config": {
      "network_interface": "eth0",
      "sport_state_topic": "rt/lf/sportmodestate",
      "low_state_max_age_s": 0.05
    }
  },
  "nominal_capabilities": [
    "locomotion",
    "low_level"
  ],
  "frames": [
    "odom",
    "base_link"
  ],
  "components": [
    {
      "component_id": "compute",
      "kind": "Onboard computer",
      "revision": "r1",
      "type_id": "compute.sbc",
      "properties": {
        "cpu_cores": 8,
        "ram": {
          "value": 8,
          "unit": "GB"
        },
        "tdp": {
          "value": 15,
          "unit": "W"
        }
      },
      "relations": [
        {
          "kind": "powered_by",
          "target": "battery"
        }
      ],
      "interfaces": [
        {
          "name": "eth0",
          "kind": "net.ethernet"
        },
        {
          "name": "dds",
          "kind": "middleware.dds"
        }
      ]
    },
    {
      "component_id": "imu",
      "kind": "Body IMU",
      "revision": "r1",
      "type_id": "sensor.imu.mems_6axis",
      "parent": "compute",
      "properties": {
        "accel_range": {
          "value": 16,
          "unit": "g0"
        },
        "gyro_range": {
          "value": 2000,
          "unit": "deg/s"
        },
        "output_data_rate": {
          "value": 500,
          "unit": "Hz"
        }
      }
    },
    {
      "component_id": "battery",
      "kind": "Main battery",
      "revision": "r1",
      "type_id": "power.battery.li_ion_nmc_pack",
      "properties": {
        "nominal_voltage": {
          "value": 28.8,
          "unit": "V"
        },
        "capacity": {
          "value": 8,
          "unit": "Ah"
        },
        "max_discharge_current": {
          "value": 30,
          "unit": "A"
        }
      }
    },
    {
      "component_id": "joint-fr-hip",
      "kind": "Leg joint module",
      "revision": "r1",
      "type_id": "actuator.module.qdd_joint",
      "properties": {
        "rated_voltage": {
          "value": 28.8,
          "unit": "V"
        },
        "rated_torque": {
          "value": 10,
          "unit": "N*m"
        },
        "peak_torque": {
          "value": 45,
          "unit": "N*m"
        },
        "gear_ratio": 6.33
      },
      "relations": [
        {
          "kind": "powered_by",
          "target": "battery"
