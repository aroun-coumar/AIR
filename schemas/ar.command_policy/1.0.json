{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.command_policy/1.0.json",
  "title": "ar.command_policy/1.0",
  "type": "object",
  "description": "Prefix rules (allow / prompt / forbidden) for commands a work agent runs; the strictest matching rule wins; examples are verified at load time.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.command_policy/1\\.\\d+|https?://.+/ar\\.command_policy/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommandRule"
      },
      "default": []
    },
    "default": {
      "enum": [
        "allow",
        "prompt",
        "forbidden"
      ],
      "default": "allow"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CommandRule": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "decision": {
          "enum": [
            "allow",
            "prompt",
            "forbidden"
          ],
          "default": "allow"
        },
        "justification": {
          "type": "string",
          "default": ""
        },
        "match": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "default": []
        },
        "not_match": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "default": []
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
