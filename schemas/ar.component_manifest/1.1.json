{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.component_manifest/1.1.json",
  "title": "ar.component_manifest/1.1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.component_manifest/1\\.\\d+|https?://.+/ar\\.component_manifest/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "robot_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "hardware_revision": {
      "type": "string"
    },
    "adapter": {
      "$ref": "#/$defs/AdapterRef"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComponentSpec"
      },
      "default": []
    },
    "nominal_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "robot_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "robot_id",
    "name",
    "hardware_revision",
    "adapter"
  ],
  "additionalProperties": false,
  "$defs": {
    "AdapterRef": {
      "type": "object",
      "description": "Which adapter implements this robot, and its adapter-specific configuration.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "config": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ComponentSpec": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterfaceSpec"
          },
          "default": []
        },
        "serial": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "properties": {
          "type": "object",
          "additionalProperties": {}
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "default": []
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LimitOverride"
          },
          "default": []
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentRef"
          },
          "default": []
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ],
          "default": "internal"
        }
      },
      "required": [
        "component_id",
        "kind",
        "revision"
      ],
      "additionalProperties": false
    },
    "DocumentRef": {
      "type": "object",
      "description": "A datasheet, drawing, test report or manual for a component, pinned by digest.",
      "properties": {
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "default": "datasheet"
        },
        "title": {
          "type": "string",
          "default": ""
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ],
          "default": "internal"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "additionalProperties": false
    },
    "InterfaceSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "LimitOverride": {
      "type": "object",
      "description": "This unit's limits for a catalog telemetry signal (from its datasheet or a test).",
      "properties": {
        "signal": {
          "type": "string"
        },
        "warn_above": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "critical_above": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warn_below": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "critical_below": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "signal"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "mounted_on",
            "powered_by",
            "drives",
            "senses",
            "communicates_via",
            "protects",
            "cools",
            "controls"
          ]
        },
        "target": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "additionalProperties": false
    }
  }
}
