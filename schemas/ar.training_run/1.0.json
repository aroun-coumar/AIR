{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.training_run/1.0.json",
  "title": "ar.training_run/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.training_run/1\\.\\d+|https?://.+/ar\\.training_run/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "run_id": {
      "type": "string"
    },
    "algorithm": {
      "type": "string"
    },
    "git": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitState"
        },
        {
          "type": "null"
        }
      ]
    },
    "nan_check": {
      "$ref": "#/$defs/NanCheck"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config": {
      "type": "object",
      "additionalProperties": {}
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "started_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "run_id",
    "algorithm",
    "git",
    "nan_check"
  ],
  "additionalProperties": false,
  "$defs": {
    "GitState": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dirty": {
          "type": "boolean",
          "default": false
        },
        "diff_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "commit"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "NanCheck": {
      "type": "object",
      "description": "Whether non-finite values were checked for, where, and what was found.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "checked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "found_non_finite": {
          "type": "boolean",
          "default": false
        },
        "first_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  }
}
