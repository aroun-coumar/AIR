{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.execution_result/1.1.json",
  "title": "ar.execution_result/1.1",
  "type": "object",
  "description": "1.1 adds the failure taxonomy (``failure``), ``retriable``, the applied command (``applied_args`` and ``limited_by`` when limits clamped the request), the ``evidence`` weighed, and ``retry_of``.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.execution_result/1\\.\\d+|https?://.+/ar\\.execution_result/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "command_id": {
      "type": "string"
    },
    "robot_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "submitted",
        "rejected",
        "awaiting_approval",
        "accepted",
        "executing",
        "paused",
        "reported_complete",
        "verified",
        "approximate",
        "skipped",
        "failed",
        "cancelling",
        "cancelled",
        "killed",
        "unresolved"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "type": "string",
      "default": ""
    },
    "observed_effects": {
      "type": "object",
      "additionalProperties": {}
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConditionResult"
      },
      "default": []
    },
    "authority_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capability_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure": {
      "anyOf": [
        {
          "enum": [
            "start_state",
            "goal",
            "frame_transform",
            "stale_state",
            "stale_sensor",
            "communication",
            "preempted",
            "timeout",
            "keepalive_lapsed",
            "authority",
            "resource",
            "capability",
            "invalid_request",
            "approval",
            "evidence",
            "hardware",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retriable": {
      "type": "boolean",
      "default": false
    },
    "applied_args": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limited_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "default": []
    },
    "retry_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "command_id",
    "robot_id",
    "skill_id",
    "state"
  ],
  "additionalProperties": false,
  "$defs": {
    "ConditionResult": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "satisfied": {
          "type": "boolean"
        },
        "observed": {
          "default": null
        },
        "expected": {
          "default": null
        },
        "observation_age_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "type": "string",
          "default": ""
        },
        "approximate": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "description",
        "satisfied"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "description": "One piece of evidence the runtime weighed. Only authoritative evidence acquired ``after`` the execution window can satisfy a postcondition.",
      "properties": {
        "signal": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "before",
            "during",
            "after"
          ]
        },
        "association_quality": {
          "type": "string",
          "default": "authoritative"
        },
        "origin": {
          "type": "string",
          "default": "measured"
        },
        "authoritative": {
          "type": "boolean",
          "default": true
        },
        "acquired_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "default": null
        },
        "verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "signal",
        "source",
        "phase"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
