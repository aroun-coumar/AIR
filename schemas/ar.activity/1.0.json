{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.activity/1.0.json",
  "title": "ar.activity/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.activity/1\\.\\d+|https?://.+/ar\\.activity/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "activity_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "research",
        "development",
        "simulation",
        "experiment",
        "evaluation",
        "release",
        "deployment",
        "execution",
        "maintenance",
        "calibration",
        "incident",
        "learning",
        "decision"
      ]
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "abandoned"
      ]
    },
    "started_at": {
      "type": "number"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "generated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "params": {
      "type": "object",
      "additionalProperties": {}
    },
    "environment": {
      "type": "object",
      "additionalProperties": {}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {}
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "outcome": {
      "type": "string",
      "default": ""
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "activity_id",
    "kind",
    "title",
    "status",
    "started_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
