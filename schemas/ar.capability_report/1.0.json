{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.capability_report/1.0.json",
  "title": "ar.capability_report/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.capability_report/1\\.\\d+|https?://.+/ar\\.capability_report/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "robot_id": {
      "type": "string"
    },
    "capability_revision": {
      "type": "integer"
    },
    "observed_at": {
      "type": "number"
    },
    "clock_domain": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CapabilityProfile"
      },
      "default": []
    }
  },
  "required": [
    "robot_id",
    "capability_revision",
    "observed_at",
    "clock_domain"
  ],
  "additionalProperties": false,
  "$defs": {
    "CapabilityProfile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "restricted",
            "unavailable"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "limiting_factors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
