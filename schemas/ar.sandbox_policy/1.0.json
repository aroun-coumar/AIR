{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.sandbox_policy/1.0.json",
  "title": "ar.sandbox_policy/1.0",
  "type": "object",
  "description": "What work in the sandbox may do, and which limits must be *enforced*.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.sandbox_policy/1\\.\\d+|https?://.+/ar\\.sandbox_policy/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "network": {
      "enum": [
        "none",
        "any"
      ],
      "default": "none"
    },
    "allowed_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "python"
      ]
    },
    "env_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "max_wall_s": {
      "type": "number",
      "default": 120.0
    },
    "max_memory_mb": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 2048
    },
    "max_cpus": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 2.0
    },
    "max_output_bytes": {
      "type": "integer",
      "default": 200000
    },
    "require_enforced": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "time",
        "env",
        "output"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
