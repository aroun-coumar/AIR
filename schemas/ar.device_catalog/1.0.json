{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.device_catalog/1.0.json",
  "title": "ar.device_catalog/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.device_catalog/1\\.\\d+|https?://.+/ar\\.device_catalog/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "name": {
      "type": "string",
      "default": "catalog"
    },
    "device_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeviceType"
      },
      "default": []
    },
    "robot_classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RobotClass"
      },
      "default": []
    },
    "protocols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Protocol"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DeviceType": {
      "type": "object",
      "properties": {
        "type_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertySpec"
          },
          "default": []
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "telemetry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignalSpec"
          },
          "default": []
        },
        "maintenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaintenanceItem"
          },
          "default": []
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "safety_relevant": {
          "type": "boolean",
          "default": false
        },
        "typical_parents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "default": []
        },
        "extends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "semantic": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ],
          "default": "public"
        }
      },
      "required": [
        "type_id",
        "name",
        "category"
      ],
      "additionalProperties": false
    },
    "MaintenanceItem": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "hours",
            "cycles",
            "distance_km",
            "calendar_days",
            "condition"
          ],
          "default": "condition"
        },
        "interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "PropertySpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "quantity",
            "number",
            "integer",
            "string",
            "enum",
            "bool"
          ],
          "default": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Protocol": {
      "type": "object",
      "properties": {
        "protocol_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "default": ""
        },
        "medium": {
          "type": "string",
          "default": ""
        },
        "realtime": {
          "type": "string",
          "default": "none"
        },
        "typical_rate": {
          "type": "string",
          "default": ""
        },
        "topology": {
          "type": "string",
          "default": ""
        },
        "security": {
          "type": "string",
          "default": ""
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "default": []
        }
      },
      "required": [
        "protocol_id",
        "name"
      ],
      "additionalProperties": false
    },
    "Reference": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "RobotClass": {
      "type": "object",
      "properties": {
        "class_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "default": []
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "safety_relevant": {
          "type": "boolean",
          "default": false
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "default": []
        }
      },
      "required": [
        "class_id",
        "name"
      ],
      "additionalProperties": false
    },
    "SignalSpec": {
      "type": "object",
      "description": "A telemetry signal and, where a typical value exists, its warn/critical limits.",
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warn_above": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "critical_above": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warn_below": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "critical_below": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Slot": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min": {
          "type": "integer",
          "default": 0
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "slot",
        "types"
      ],
      "additionalProperties": false
    }
  }
}
