{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.diagnosis_table/1.0.json",
  "title": "ar.diagnosis_table/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.diagnosis_table/1\\.\\d+|https?://.+/ar\\.diagnosis_table/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosisEntry"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DiagnosisEntry": {
      "type": "object",
      "properties": {
        "fault_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "threshold": {
          "type": "integer",
          "default": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "fatal"
          ],
          "default": "error"
        },
        "delay_s": {
          "type": "number",
          "default": 0.0
        },
        "failure_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "fault_id",
        "description"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
