{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.human_intervention/1.0.json",
  "title": "ar.human_intervention/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.human_intervention/1\\.\\d+|https?://.+/ar\\.human_intervention/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "intervention_id": {
      "type": "string"
    },
    "operator": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "priority_change",
        "mission_hold",
        "task_cancel",
        "manual_takeover",
        "maintenance_mode",
        "protective_stop",
        "handback"
      ]
    },
    "robots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "requested",
        "accepted",
        "transitioning",
        "active",
        "unconfirmed",
        "completed"
      ],
      "default": "requested"
    },
    "revoked_delegations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "command_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "physically_confirmed": {
      "type": "boolean",
      "default": false
    },
    "handback_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "intervention_id",
    "operator",
    "kind",
    "robots"
  ],
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
