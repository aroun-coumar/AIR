{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.approval_decision/1.0.json",
  "title": "ar.approval_decision/1.0",
  "type": "object",
  "description": "A recorded decision on an :class:`ApprovalRequest`. ``authority_revision`` is the authority state the approver decided under; a stale one is refused.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.approval_decision/1\\.\\d+|https?://.+/ar\\.approval_decision/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "command_id": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "approver": {
      "type": "string"
    },
    "authority_revision": {
      "type": "integer"
    },
    "args_digest": {
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "delegation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "command_id",
    "decision",
    "approver",
    "authority_revision",
    "args_digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
