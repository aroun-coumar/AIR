{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.maintenance_record/1.0.json",
  "title": "ar.maintenance_record/1.0",
  "type": "object",
  "description": "Baseline section 16: lineage-preserving service record.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.maintenance_record/1\\.\\d+|https?://.+/ar\\.maintenance_record/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "record_id": {
      "type": "string"
    },
    "robot_id": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "maintenance_type": {
      "type": "string",
      "default": "corrective"
    },
    "operating_mode": {
      "type": "string",
      "default": "maintenance"
    },
    "procedure": {
      "type": "string",
      "default": ""
    },
    "performed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "replacements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Replacement"
      },
      "default": []
    },
    "calibration_invalidated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "return_to_service_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "record_id",
    "robot_id",
    "components",
    "reason"
  ],
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Replacement": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "string"
        },
        "installed": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "removed",
        "installed"
      ],
      "additionalProperties": false
    }
  }
}
