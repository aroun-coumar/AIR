{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.package/1.0.json",
  "title": "ar.package/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.package/1\\.\\d+|https?://.+/ar\\.package/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "primitive",
        "service",
        "skill",
        "bundle"
      ]
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "provides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Provide"
      },
      "default": []
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Require"
      },
      "default": []
    },
    "depends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackageDependency"
      },
      "default": []
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackageDependency"
      },
      "default": []
    },
    "hardware": {
      "$ref": "#/$defs/HardwareRequirements"
    },
    "host": {
      "$ref": "#/$defs/HostRequirements"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillSpec"
      },
      "default": []
    },
    "config": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParamSpec"
      },
      "default": []
    },
    "entrypoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "version",
    "kind",
    "description",
    "license"
  ],
  "additionalProperties": false,
  "$defs": {
    "Condition": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "approx",
            "present"
          ]
        },
        "value": {
          "default": null
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tolerance": {
          "type": "number",
          "default": 0.0
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "accept_within": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "signal",
        "op"
      ],
      "additionalProperties": false
    },
    "DeviceRequirement": {
      "type": "object",
      "description": "A device the package needs: catalog type patterns and a minimum count.",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min": {
          "type": "integer",
          "default": 1
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "types"
      ],
      "additionalProperties": false
    },
    "ExecutionContract": {
      "type": "object",
      "description": "Timing, freshness and fallback terms a feature or skill executes under.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "trigger": {
          "type": "string",
          "default": "on_command"
        },
        "deadline_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deadline_kind": {
          "enum": [
            "hard",
            "firm",
            "soft"
          ],
          "default": "firm"
        },
        "period_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_input_age_s": {
          "type": "number",
          "default": 1.0
        },
        "result_validity_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "jitter_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "queue_policy": {
          "enum": [
            "reject_if_busy",
            "queue_fifo",
            "replace_latest"
          ],
          "default": "reject_if_busy"
        },
        "compute_budget": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_budget_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "allowed_clock_states": {
          "type": "array",
          "items": {
            "enum": [
              "locked",
              "holdover",
              "unsynchronized"
            ]
          },
          "default": [
            "locked",
            "holdover"
          ]
        },
        "fallback": {
          "type": "string",
          "default": "stop"
        },
        "keepalive_period_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_mode": {
          "enum": [
            "hold",
            "damp"
          ],
          "default": "hold"
        }
      },
      "additionalProperties": false
    },
    "HardwareRequirements": {
      "type": "object",
      "description": "What the package needs from a robot. Empty means it needs nothing.",
      "properties": {
        "robot_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceRequirement"
          },
          "default": []
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "incompatible_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "notes": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "HostRequirements": {
      "type": "object",
      "properties": {
        "os": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "arch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "python": {
          "type": "string",
          "default": "*"
        }
      },
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "PackageDependency": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "range": {
          "type": "string",
          "default": "*"
        }
      },
      "required": [
        "package"
      ],
      "additionalProperties": false
    },
    "ParamSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "Provide": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "interface",
        "version"
      ],
      "additionalProperties": false
    },
    "RelativeTargetLimit": {
      "type": "object",
      "description": "Largest allowed change of a target argument from its currently observed value (LeRobot ``max_relative_target``). The current value is read from ``signal`` (optionally ``field``) at dispatch.",
      "properties": {
        "arg": {
          "type": "string"
        },
        "signal": {
          "type": "string"
        },
        "max_delta": {
          "type": "number"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action": {
          "enum": [
            "reject",
            "clamp"
          ],
          "default": "clamp"
        }
      },
      "required": [
        "arg",
        "signal",
        "max_delta"
      ],
      "additionalProperties": false
    },
    "Require": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string"
        },
        "range": {
          "type": "string",
          "default": "*"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "interface"
      ],
      "additionalProperties": false
    },
    "SkillSpec": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "skill_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamSpec"
          },
          "default": []
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "default": []
        },
        "postconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "default": []
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "interruption": {
          "enum": [
            "none",
            "cancel",
            "pause"
          ],
          "default": "cancel"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContract"
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "on_uncertain_outcome": {
          "type": "string",
          "default": "reconcile"
        },
        "experimental": {
          "type": "boolean",
          "default": false
        },
        "occupies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "blocking": {
          "enum": [
            "none",
            "soft",
            "hard"
          ],
          "default": "hard"
        },
        "skip_if": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "default": []
        },
        "requires_approval": {
          "type": "boolean",
          "default": false
        },
        "approval_timeout_s": {
          "type": "number",
          "default": 60.0
        },
        "retriable_failures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_relative_target": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelativeTargetLimit"
          },
          "default": []
        }
      },
      "required": [
        "skill_id",
        "version",
        "description"
      ],
      "additionalProperties": false
    },
    "WorkspaceBox": {
      "type": "object",
      "description": "Axis-aligned box the target arguments must lie in (RAI ``WorkspaceBounds``).",
      "properties": {
        "frame": {
          "type": "string"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "action": {
          "enum": [
            "reject",
            "clamp"
          ],
          "default": "reject"
        }
      },
      "required": [
        "frame",
        "bounds"
      ],
      "additionalProperties": false
    }
  }
}
