{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.asset_card/1.0.json",
  "title": "ar.asset_card/1.0",
  "type": "object",
  "description": "What an asset is for and where it stops. A claim, never authority.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.asset_card/1\\.\\d+|https?://.+/ar\\.asset_card/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "asset": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "model",
        "dataset",
        "policy",
        "skill"
      ]
    },
    "title": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "default": ""
    },
    "intended_use": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "out_of_scope_use": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "operating_envelope": {
      "type": "object",
      "additionalProperties": {}
    },
    "evaluations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvaluationEvidence"
      },
      "default": []
    },
    "conformance_report": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "asset",
    "kind",
    "title",
    "license"
  ],
  "additionalProperties": false,
  "$defs": {
    "EvaluationEvidence": {
      "type": "object",
      "description": "One evaluation result and where its evidence lives (a ledger entry, a report).",
      "properties": {
        "name": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": []
        },
        "air_version": {
          "type": "string",
          "default": ""
        },
        "platform": {
          "type": "string",
          "default": ""
        },
        "evidence": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "name",
        "metric"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
