{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.conformance_report/1.0.json",
  "title": "ar.conformance_report/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.conformance_report/1\\.\\d+|https?://.+/ar\\.conformance_report/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "robot_id": {
      "type": "string"
    },
    "adapter_kind": {
      "type": "string"
    },
    "suite_version": {
      "type": "string"
    },
    "air_version": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConformanceCheck"
      }
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "manifest_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "skills_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "robot_id",
    "adapter_kind",
    "suite_version",
    "air_version",
    "passed",
    "outcomes"
  ],
  "additionalProperties": false,
  "$defs": {
    "ConformanceCheck": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
