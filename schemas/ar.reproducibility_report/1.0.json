{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.reproducibility_report/1.0.json",
  "title": "ar.reproducibility_report/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.reproducibility_report/1\\.\\d+|https?://.+/ar\\.reproducibility_report/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "backend": {
      "type": "string"
    },
    "backend_version": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "steps": {
      "type": "integer"
    },
    "tolerance": {
      "type": "number"
    },
    "outcome": {
      "enum": [
        "exact",
        "within_tolerance",
        "differs"
      ]
    },
    "max_abs_diff": {
      "type": "number",
      "default": 0.0
    },
    "declared_determinism": {
      "enum": [
        "unknown",
        "statistical",
        "bitwise_same_host",
        "bitwise"
      ],
      "default": "unknown"
    },
    "rng_state_match": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reset_repeatable": {
      "type": "boolean",
      "default": false
    },
    "buffer_reuse": {
      "type": "boolean",
      "default": false
    },
    "restore_check": {
      "type": "string",
      "default": "not_supported"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "config": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "backend",
    "backend_version",
    "platform",
    "seed",
    "steps",
    "tolerance",
    "outcome"
  ],
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
