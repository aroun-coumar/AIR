{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.work_task/1.0.json",
  "title": "ar.work_task/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.work_task/1\\.\\d+|https?://.+/ar\\.work_task/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "task_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "research",
        "development",
        "simulation",
        "evaluation",
        "maintenance",
        "diagnosis"
      ]
    },
    "goal": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "approval_required": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "workspace",
          "compute",
          "project",
          "external",
          "robot",
          "promote"
        ]
      },
      "default": [
        "external",
        "robot",
        "promote"
      ]
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "default": "internal"
    },
    "budget": {
      "$ref": "#/$defs/WorkBudget"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxPolicy"
    },
    "models": {
      "$ref": "#/$defs/ModelConstraints"
    },
    "robot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "task_id",
    "kind",
    "goal"
  ],
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "ModelConstraints": {
      "type": "object",
      "properties": {
        "allowed_locations": {
          "type": "array",
          "items": {
            "enum": [
              "cloud",
              "edge",
              "local_host",
              "on_robot"
            ]
          },
          "default": [
            "cloud",
            "edge",
            "local_host",
            "on_robot"
          ]
        },
        "allow_data_egress": {
          "type": "boolean",
          "default": true
        },
        "robot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prefer": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "SandboxPolicy": {
      "type": "object",
      "description": "What work in the sandbox may do, and which limits must be *enforced*.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "network": {
          "enum": [
            "none",
            "any"
          ],
          "default": "none"
        },
        "allowed_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "python"
          ]
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "max_wall_s": {
          "type": "number",
          "default": 120.0
        },
        "max_memory_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2048
        },
        "max_cpus": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 2.0
        },
        "max_output_bytes": {
          "type": "integer",
          "default": 200000
        },
        "require_enforced": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "time",
            "env",
            "output"
          ]
        }
      },
      "additionalProperties": false
    },
    "WorkBudget": {
      "type": "object",
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "default": 20
        },
        "max_tool_calls": {
          "type": "integer",
          "default": 60
        },
        "max_wall_s": {
          "type": "number",
          "default": 900.0
        }
      },
      "additionalProperties": false
    }
  }
}
