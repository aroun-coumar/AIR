{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.work_task/1.1.json",
  "title": "ar.work_task/1.1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.work_task/1\\.\\d+|https?://.+/ar\\.work_task/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "task_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "research",
        "development",
        "simulation",
        "evaluation",
        "maintenance",
        "diagnosis"
      ]
    },
    "goal": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "approval_required": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "workspace",
          "compute",
          "project",
          "external",
          "robot",
          "promote"
        ]
      },
      "default": [
        "external",
        "robot",
        "promote"
      ]
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "default": "internal"
    },
    "budget": {
      "$ref": "#/$defs/WorkBudget"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxPolicy"
    },
    "models": {
      "$ref": "#/$defs/ModelConstraints"
    },
    "robot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "command_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confirm_risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "default": "high"
    },
    "approval_mode": {
      "enum": [
        "ask",
        "dont_ask"
      ],
      "default": "ask"
    }
  },
  "required": [
    "task_id",
    "kind",
    "goal"
  ],
  "additionalProperties": false,
  "$defs": {
    "CommandPolicy": {
      "type": "object",
      "description": "Prefix rules (allow / prompt / forbidden) for commands a work agent runs; the strictest matching rule wins; examples are verified at load time.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandRule"
          },
          "default": []
        },
        "default": {
          "enum": [
            "allow",
            "prompt",
            "forbidden"
          ],
          "default": "allow"
        }
      },
      "additionalProperties": false
    },
    "CommandRule": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "decision": {
          "enum": [
            "allow",
            "prompt",
            "forbidden"
          ],
          "default": "allow"
        },
        "justification": {
          "type": "string",
          "default": ""
        },
        "match": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "default": []
        },
        "not_match": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "default": []
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "EgressPolicy": {
      "type": "object",
      "description": "Where a proxied sandbox may connect. Everything not allowed is denied.",
      "properties": {
        "allow_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "deny_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allow_cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allow_ports": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            80,
            443
          ]
        },
        "tls_origination": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "secrets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretBinding"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "ModelConstraints": {
      "type": "object",
      "properties": {
        "allowed_locations": {
          "type": "array",
          "items": {
            "enum": [
              "cloud",
              "edge",
              "local_host",
              "on_robot"
            ]
          },
          "default": [
            "cloud",
            "edge",
            "local_host",
            "on_robot"
          ]
        },
        "allow_data_egress": {
          "type": "boolean",
          "default": true
        },
        "robot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prefer": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "SandboxPolicy": {
      "type": "object",
      "description": "What work in the sandbox may do, and which limits must be *enforced*.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "network": {
          "enum": [
            "none",
            "any",
            "proxy"
          ],
          "default": "none"
        },
        "allowed_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "python"
          ]
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "max_wall_s": {
          "type": "number",
          "default": 120.0
        },
        "max_memory_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2048
        },
        "max_cpus": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 2.0
        },
        "max_output_bytes": {
          "type": "integer",
          "default": 200000
        },
        "require_enforced": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "time",
            "env",
            "output"
          ]
        },
        "mode": {
          "enum": [
            "strict",
            "best_effort"
          ],
          "default": "strict"
        },
        "egress": {
          "$ref": "#/$defs/EgressPolicy"
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git"
          ]
        },
        "deny_read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "SecretBinding": {
      "type": "object",
      "description": "A credential the sandbox may *use* but never *hold*.",
      "properties": {
        "env": {
          "type": "string"
        },
        "source_env": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "header_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "authorization"
          ]
        },
        "allow_plain_http": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "env",
        "source_env",
        "hosts"
      ],
      "additionalProperties": false
    },
    "WorkBudget": {
      "type": "object",
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "default": 20
        },
        "max_tool_calls": {
          "type": "integer",
          "default": 60
        },
        "max_wall_s": {
          "type": "number",
          "default": 900.0
        }
      },
      "additionalProperties": false
    }
  }
}
