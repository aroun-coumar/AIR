{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.source_catalog/1.0.json",
  "title": "ar.source_catalog/1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.source_catalog/1\\.\\d+|https?://.+/ar\\.source_catalog/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "name": {
      "type": "string",
      "default": "sources"
    },
    "updated": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "SourceRecord": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "host": {
          "enum": [
            "github",
            "gitee",
            "atomgit",
            "gitcode",
            "gitlab",
            "other"
          ]
        },
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "area": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "default": ""
        },
        "topic": {
          "type": "string",
          "default": ""
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "agpl_compatible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_push": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "archived": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verified": {
          "type": "array",
          "items": {
            "enum": [
              "license",
              "activity",
              "files"
            ]
          },
          "default": []
        },
        "files_read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "learn": {
          "type": "string",
          "default": ""
        },
        "air_modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "adopt_mode": {
          "enum": [
            "adopt_pattern",
            "optional_integration",
            "reference",
            "avoid"
          ],
          "default": "reference"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "default": "P2"
        },
        "notes": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "url",
        "host",
        "owner",
        "name",
        "area"
      ],
      "additionalProperties": false
    }
  }
}
