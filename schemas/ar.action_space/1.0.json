{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aroun-coumar/AIR/main/schemas/ar.action_space/1.0.json",
  "title": "ar.action_space/1.0",
  "type": "object",
  "description": "An ordered registry of named slots. Every embodiment maps into the same vector; slots it does not have are masked out instead of being zero-filled silently.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Contract tag (ar.<name>/<major>.<minor>) or its schema URI",
      "pattern": "^(?:ar\\.action_space/1\\.\\d+|https?://.+/ar\\.action_space/1\\.\\d+\\.json)$"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "space_id": {
      "type": "string"
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActionSlot"
      }
    },
    "description": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "space_id",
    "slots"
  ],
  "additionalProperties": false,
  "$defs": {
    "ActionSlot": {
      "type": "object",
      "description": "One named, unit-bearing segment of a unified action vector.",
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "default": 1
        },
        "unit": {
          "type": "string",
          "default": "1"
        },
        "description": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "description": "Provenance, access scope and revision carried by every contract (baseline section 6).",
      "properties": {
        "source": {
          "type": "string",
          "default": "unspecified"
        },
        "access_scope": {
          "type": "string",
          "default": "project"
        },
        "revision": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
