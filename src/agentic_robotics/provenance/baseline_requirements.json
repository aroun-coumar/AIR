  "requirements": [
    { "req_id": "REQ01", "title": "Reusable tool, framework, library and optional platform embedded by downstream developers", "owner": "Public SDK and extension contracts" },
    { "req_id": "REQ02", "title": "End-to-end research, development, simulation, evaluation and implementation support", "owner": "Engineering and evaluation" },
    { "req_id": "REQ03", "title": "Coverage across the 19 hardware, software, infrastructure and environment domains", "owner": "Domain adapters and system model" },
    { "req_id": "REQ04", "title": "Agentic optimization and configuration down to hardware", "owner": "Engineering agents and optimization" },
    { "req_id": "REQ05", "title": "Agentic intelligence within individual robotic systems", "owner": "Agents, skills and local runtime" },
    { "req_id": "REQ06", "title": "Multiple software agents within a robot and coordination among physical robots", "owner": "Agent composition and team coordination" },
    { "req_id": "REQ07", "title": "Intelligent conversation leading to executable commitments and verified outcomes", "owner": "Interaction and commitment protocols" },
    { "req_id": "REQ08", "title": "Shared memory and context reuse to reduce repeated model input and reasoning", "owner": "Memory and context selection" },
    { "req_id": "REQ09", "title": "Fast task decomposition, allocation, prioritization, dispatch and selective acknowledgement", "owner": "Scheduler and coordination" },
    { "req_id": "REQ10", "title": "Accountable agreement and task records, with blockchain-like mechanisms where appropriate", "owner": "Pluggable ledger and audit interfaces" },
    { "req_id": "REQ11", "title": "Guided and anticipatory transfer of learning with context enrichment", "owner": "Knowledge qualification and handoff" },
    { "req_id": "REQ12", "title": "Real-time inference, execution and synchronization of robots and features", "owner": "Execution contracts and local runtime" },
    { "req_id": "REQ13", "title": "Hardware bottleneck awareness and appropriate adaptation", "owner": "Resource and capability supervision" },
    { "req_id": "REQ14", "title": "Detection, investigation, learning and handling of unfamiliar failures", "owner": "Incidents, diagnosis and recovery" },
    { "req_id": "REQ15", "title": "Robot and team monitoring linked to mission consequences", "owner": "Observability and operator interfaces" },
    { "req_id": "REQ16", "title": "Maintenance and component lifecycle management", "owner": "Operations and asset lifecycle" },
    { "req_id": "REQ17", "title": "Human intervention, override, bounded delegation, takeover and handback", "owner": "Authority and command arbitration" },
    { "req_id": "REQ18", "title": "Developer experience comparable to established AI libraries and ecosystems", "owner": "Packaging, documentation, plugins and asset registry" },

